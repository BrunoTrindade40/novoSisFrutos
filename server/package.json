  "main": "index.js",
  "scripts": {
    "build": "tsc --outDir dist",
    "obfuscate": "node obfuscate.js",
    "build:obfuscate": "npm run build && npm run obfuscate",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "//----- SCRIPTS DO PRISMA -----//": "",
    "prisma:dev:migrate": "dotenv -e .env.development -- npx prisma migrate dev",
    "prisma:dev:generate": "dotenv -e .env.development -- npx prisma generate",
    "prisma:prod:generate": "dotenv -e .env.production -- npx prisma generate",
    "prisma:dev:studio": "dotenv -e .env.development -- npx prisma studio",
    "prisma:test:deploy": "dotenv -e .env.test -- npx prisma migrate deploy"
  },
  "keywords": [],
