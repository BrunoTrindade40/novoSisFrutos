{
  "compilerOptions": {
    /* Configurações de Compilação Modernas */
    "target": "ES2022", // Atualizado para Node 18+ (suporta features mais novas e rápidas)
    "module": "Node16", // <--- ALTERADO: De 'commonjs' para 'Node16' (Obrigatório para parear com moduleResolution)
    "moduleResolution": "Node16", // CORREÇÃO 1: Substitui 'node' (que era node10). Alinha com o runtime real do Node.

    /* Estrutura de Pastas */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Alias de Importação (Paths) */
    // CORREÇÃO 2: Removemos "baseUrl". Agora os paths são relativos ao tsconfig.
    "paths": {
      "@/*": ["./src/*"] // Adicionamos './' para indicar caminho relativo
    },

    /* Interoperabilidade e Bibliotecas */
    "esModuleInterop": true,
    "resolveJsonModule": true, // Permite importar arquivos .json (útil em backends)
    "forceConsistentCasingInFileNames": true,

    /* Strictness (Segurança de Tipagem) */
    "strict": true,
    "skipLibCheck": true // Pula verificação de types em node_modules (ganho de performance)
  },
  "include": [
    "src/**/*",
    "src/__tests__/**/*",
    "src/jest.config.ts",
    "../vitest.config.ts"
  ]
}
