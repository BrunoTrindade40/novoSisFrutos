{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "//----- SCRIPTS DE DESENVOLVIMENTO -----//": "",
    "dev:Frutas_BS": "vite --mode production_Frutas_BS",
    "dev:Frutas_Uniao": "vite --mode production_Frutas_Uniao",
    "//----- SCRIPTS DE BUILD -----//": "",
    "build:Frutas_BS": "tsc -p tsconfig.build.json && vite build --mode production_Frutas_BS",
    "build:Frutas_Uniao": "tsc -p tsconfig.build.json && vite build --mode production_Frutas_Uniao",
    "//----- SCRIPTS DE START / PREVIEW -----//": "",
    "start:Frutas_BS": "vite preview --mode production_Frutas_BS",
    "start:Frutas_Uniao": "vite preview --mode production_Frutas_Uniao",
    "preview:Frutas_BS": "vite preview --mode production_Frutas_BS",
    "//----- OFUSCAÇÃO -----//": "",
    "build:obfuscate:Frutas_BS": "npm run build:Frutas_BS && node obfuscate-frontend.js",
    "build:obfuscate:Frutas_Uniao": "npm run build:Frutas_Uniao && node obfuscate-frontend.js",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.0.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.1.2",
    "@mui/system": "^7.1.1",
    "axios": "^1.13.2",
    "normalize.css": "^8.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.56.3",
    "react-imask": "^7.6.1",
    "react-input-mask": "^2.0.4",
    "react-router-dom": "^7.6.0",
    "zod": "^3.25.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/css-modules": "^1.0.5",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/react-input-mask": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/ui": "^3.1.4",
    "babel-jest": "^29.7.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "javascript-obfuscator": "^4.1.1",
    "jest": "^29.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
